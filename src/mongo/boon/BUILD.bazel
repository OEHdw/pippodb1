load("//bazel:mongo_src_rules.bzl", "mongo_cc_library", "mongo_cc_test", "mongo_cc_benchmark")

package(default_visibility = ["//visibility:public"])

# BOON Core Library
mongo_cc_library(
    name = "boon",
    srcs = [
        "boonobj.cpp",
        "bson_boon_converter.cpp",
        "uniform_array.cpp",
    ],
    hdrs = [
        "boonelement.h",
        "boonobj.h",
        "boontypes.h",
        "bson_boon_converter.h",
        "uniform_array.h",
    ],
    deps = [
        "//src/mongo/bson:bson",
        "//src/mongo/base:base",
    ],
)

# BOON Unit Tests
mongo_cc_test(
    name = "boon_test",
    srcs = [
        "boon_test.cpp",
    ],
    deps = [
        ":boon",
        "//src/mongo/unittest:unittest",
    ],
)

# UniformArray Tests
mongo_cc_test(
    name = "uniform_array_test",
    srcs = [
        "uniform_array_test.cpp",
    ],
    deps = [
        ":boon",
        "//src/mongo/unittest:unittest",
    ],
)

# BSON-BOON Converter Tests
mongo_cc_test(
    name = "bson_boon_converter_test",
    srcs = [
        "bson_boon_converter_test.cpp",
    ],
    deps = [
        ":boon",
        "//src/mongo/unittest:unittest",
    ],
)

# BOON Benchmark
mongo_cc_benchmark(
    name = "boon_bm",
    srcs = [
        "boon_bm.cpp",
    ],
    deps = [
        ":boon",
    ],
)
